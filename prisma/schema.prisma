generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth) ─────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  phone        String?  @unique
  email        String?  @unique
  passwordHash String
  name         String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  // New unified profile
  userProfile     UserProfile?
  surveySessions  SurveySession[]
  // Legacy (kept temporarily for data migration)
  basicProfile    BasicProfile?
  healthProfile   HealthProfile?
  dietProfile     DietProfile?
  // Other
  mealPlans       MealPlan[]
  feedbacks       MealFeedback[]
  reminders       Reminder[]
  healthRecords   HealthRecord[]
  onboardingState OnboardingState?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Onboarding ───────────────────────────────────────────────────────────────

model OnboardingState {
  id               String   @id @default(cuid())
  userId           String   @unique
  completedSteps   String   @default("[]")
  currentStep      String   @default("welcome")
  privacyConsented Boolean  @default(false)
  surveyCompleted  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Unified User Profile ────────────────────────────────────────────────────

model UserProfile {
  id        String @id @default(cuid())
  userId    String @unique

  // ── basicInfo ──
  age            Int?
  gender         String? // "male" | "female" | "other"
  heightCm       Float?
  weightKg       Float?
  targetWeightKg Float?
  activityLevel  String? // "sedentary" | "light" | "moderate" | "active" | "very_active"

  // ── healthMetrics ──
  bloodSugarMmol  Float?
  bloodPressureSys Int?
  bloodPressureDia Int?
  bodyFatPercent   Float?
  uricAcidUmol    Float?
  cholesterolMmol Float?
  chronicDiseases String @default("[]") // JSON: string[]

  // ── dietaryRestrictions (4-level severity) ──
  allergies            String  @default("[]") // L1: 医学过敏（绝对排除）
  medicalRestrictions  String  @default("[]") // L2: 医嘱/健康限制（控糖、低盐、低嘌呤等）
  forbiddenIngredients String  @default("[]") // L3: 用户明确绝对不吃的食材
  avoidIngredients     String  @default("[]") // L4: 一般不喜欢、尽量避免
  doctorNotes          String?                // 医嘱原始文本（补充上下文，非唯一约束来源）

  // ── dietaryPreferences ──
  tastePref          String  @default("[]") // JSON: string[]
  cuisinePref        String  @default("[]") // JSON: string[]
  dietStyle          String? // "balanced"|"low_carb"|"vegetarian"|"vegan"|"mediterranean"
  staplePreference   String? // "rice"|"noodles"|"mixed"|"grains"
  proteinPreference  String  @default("[]") // JSON: string[] (multi-select)
  cookingMethodPref  String  @default("[]") // JSON: string[] e.g. ["炒","炖","蒸","煮","焖","凉拌","煎","汤羹","一锅出"]

  // ── lifestyleContext ──
  budgetPerMeal      Int?
  cookingAbility     String? // "none"|"basic"|"intermediate"|"advanced"
  maxCookTimeMinutes Int?
  usualDiningPeople  Int     @default(1) // 日常几个人吃

  // ── healthGoals ──
  healthGoals String @default("[]") // JSON: string[] e.g. ["减脂","控糖","控血压","增肌","规律饮食"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Survey Sessions (conversation log, NOT a data source for meal generation) ──

model SurveySession {
  id               String   @id @default(cuid())
  userId           String
  messages         String   // JSON: 完整对话记录
  extractedResult  String?  // JSON: AI 从对话提取的完整结构化结果（原始快照）
  suggestedUpdates String?  // JSON: 与当前 UserProfile 比较后的待确认更新项
  appliedFields    String?  // JSON: 用户最终确认并应用的字段列表
  status           String   @default("in_progress") // in_progress|completed|applied|abandoned
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Legacy Profile Tables (kept for data migration, will be dropped) ────────

model BasicProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  age            Int?
  gender         String?
  heightCm       Float?
  weightKg       Float?
  targetWeightKg Float?
  activityLevel  String?
  sleepHour      Int?
  wakeHour       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  bloodSugarMmol   Float?
  bloodPressureSys Int?
  bloodPressureDia Int?
  bodyFatPercent   Float?
  uricAcidUmol     Float?
  cholesterolMmol  Float?
  chronicDiseases  String   @default("[]")
  allergies        String   @default("[]")
  dietaryTaboos    String   @default("[]")
  doctorNotes      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DietProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  tastePref        String   @default("[]")
  cuisinePref      String   @default("[]")
  avoidIngredients String   @default("[]")
  dietStyle        String?
  budgetRange      String?
  budgetPerMeal    Int?
  cookingAbility   String?
  takeoutFreq      String?
  hardConstraints  String   @default("[]")
  surveyRawData    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Meal Plans ───────────────────────────────────────────────────────────────

model MealPlan {
  id          String   @id @default(cuid())
  userId      String
  date        String // "YYYY-MM-DD"
  generatedAt DateTime @default(now())
  aiModel     String   @default("claude-sonnet-4-6")

  meals MealItem[]
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model MealItem {
  id              String   @id @default(cuid())
  mealPlanId      String
  slot            String // "breakfast"|"lunch"|"dinner"|"snack"
  dishName        String
  recommendReason String
  imageUrl        String?
  cookTimeMinutes Int?
  difficulty      String? // "easy"|"medium"|"hard"
  servings        Int      @default(1)
  ingredients     String // JSON: Ingredient[]
  cookingSteps    String // JSON: CookingStep[]
  nutrition       String // JSON: NutritionInfo
  alternatives    String   @default("[]") // JSON: AlternativeDish[]
  tags            String   @default("[]") // JSON: string[]
  createdAt       DateTime @default(now())

  feedbacks MealFeedback[]
  mealPlan  MealPlan       @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
}

model MealFeedback {
  id        String   @id @default(cuid())
  userId    String
  mealId    String
  type      String // "ate"|"dislike"|"too_complex"|"too_expensive"|"swap"
  note      String?
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal MealItem @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mealId])
}

// ─── Reminders ────────────────────────────────────────────────────────────────

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  slot      String // "breakfast"|"lunch"|"dinner"|"snack"
  timeHHMM  String // "08:00"
  enabled   Boolean  @default(true)
  days      String   @default("[0,1,2,3,4,5,6]") // JSON: number[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Health Records (P1) ──────────────────────────────────────────────────────

model HealthRecord {
  id               String   @id @default(cuid())
  userId           String
  recordDate       String // "YYYY-MM-DD"
  weightKg         Float?
  bloodSugarMmol   Float?
  bloodPressureSys Int?
  bloodPressureDia Int?
  note             String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordDate])
}
